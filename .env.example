OPENAI_API_KEY=

# Central model routing
MAIN_MODEL=gpt-5.6-terra
RAG_ANSWER_MODEL=gpt-4.1-mini
RECOMMENDATION_MODEL=gpt-4.1-mini
SPEAKER_REVIEW_MODEL=gpt-5.6-luna
SPEAKER_ADJUDICATION_MODEL=gpt-5.6-terra
SPEAKER_FINAL_REVIEW_MODEL=gpt-5.6-sol
SPEAKER_REVIEW_REASONING_EFFORT=low
SPEAKER_ADJUDICATION_REASONING_EFFORT=medium
SPEAKER_FINAL_REVIEW_REASONING_EFFORT=high

# Application runtime (development defaults use private on-disk Qdrant)
CINEGRAPH_ENVIRONMENT=development
CINEGRAPH_KNOWLEDGE_ROOT=knowledge
CINEGRAPH_IDENTITY_DATABASE_PATH=knowledge/cinegraph-development.sqlite3
# Optional SQLAlchemy URL. Development defaults to the path above; production
# must use postgresql+psycopg:// and keep credentials in a secret store.
# CINEGRAPH_DATABASE_URL=sqlite+pysqlite:///knowledge/cinegraph-development.sqlite3
CINEGRAPH_DATABASE_POOL_SIZE=5
CINEGRAPH_DATABASE_MAX_OVERFLOW=10
CINEGRAPH_DATABASE_POOL_TIMEOUT_SECONDS=30
CINEGRAPH_DATABASE_POOL_RECYCLE_SECONDS=1800
CINEGRAPH_QDRANT_MODE=local
CINEGRAPH_QDRANT_LOCAL_PATH=knowledge/qdrant-development
CINEGRAPH_QDRANT_COLLECTION_NAME=transcript_segments_development
CINEGRAPH_API_HOST=127.0.0.1
CINEGRAPH_API_PORT=8000
# Embedding runtime defaults. The restricted corpus worker uses its fixed 8/1 profile.
CINEGRAPH_EMBEDDING_MAX_BATCH_SIZE=64
CINEGRAPH_EMBEDDING_INFERENCE_THREADS=4
# Remote mode (required for production)
# CINEGRAPH_QDRANT_URL=https://qdrant.example.com
# CINEGRAPH_QDRANT_API_KEY=
