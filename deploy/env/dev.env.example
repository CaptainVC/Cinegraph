# Bootstrap copies this to root:root mode 0600 at /etc/cinegraph/dev.env when absent.
# Populate only the private host copy; never commit or print it.
CINEGRAPH_ENVIRONMENT=development
CINEGRAPH_STACK_NAME=cinegraph-dev
CINEGRAPH_ENV_FILE=/etc/cinegraph/dev.env
CINEGRAPH_IMAGE=ghcr.io/captainvc/cinegraph
CINEGRAPH_IMAGE_DIGEST=sha256:REPLACE_WITH_64_CHAR_IMAGE_DIGEST
CINEGRAPH_RELEASE_SHA=REPLACE_WITH_40_CHAR_GIT_SHA
CINEGRAPH_PUBLISHED_PORT=18000

# Required secrets: replace placeholders in the private file; never commit it.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
POSTGRES_USER=cinegraph_dev
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=cinegraph_dev

CINEGRAPH_KNOWLEDGE_ROOT=/app/knowledge
CINEGRAPH_IDENTITY_DATABASE_PATH=/app/knowledge/cinegraph-development.sqlite3
CINEGRAPH_DATABASE_URL=postgresql+psycopg://cinegraph_dev:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/cinegraph_dev
CINEGRAPH_DATABASE_POOL_SIZE=5
CINEGRAPH_DATABASE_MAX_OVERFLOW=10
CINEGRAPH_DATABASE_POOL_TIMEOUT_SECONDS=30
CINEGRAPH_DATABASE_POOL_RECYCLE_SECONDS=1800
CINEGRAPH_QDRANT_MODE=remote
CINEGRAPH_QDRANT_URL=http://qdrant:6333
CINEGRAPH_QDRANT_API_KEY=
CINEGRAPH_QDRANT_COLLECTION_NAME=transcript_segments_development
CINEGRAPH_API_HOST=0.0.0.0
CINEGRAPH_API_PORT=8000
CINEGRAPH_APP_MEMORY_LIMIT=768m
CINEGRAPH_APP_CPU_LIMIT=1.0
CINEGRAPH_POSTGRES_MEMORY_LIMIT=512m
CINEGRAPH_POSTGRES_CPU_LIMIT=1.0
CINEGRAPH_QDRANT_MEMORY_LIMIT=768m
CINEGRAPH_QDRANT_CPU_LIMIT=1.0
