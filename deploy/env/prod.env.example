# Copy to /etc/cinegraph/prod.env with mode 0600. This private file is intentionally
# a contract only; replace every REPLACE_* value in the private copy.
CINEGRAPH_ENVIRONMENT=production
CINEGRAPH_STACK_NAME=cinegraph-prod
CINEGRAPH_ENV_FILE=/etc/cinegraph/prod.env
CINEGRAPH_IMAGE=ghcr.io/captainvc/cinegraph
CINEGRAPH_IMAGE_DIGEST=sha256:REPLACE_WITH_64_CHAR_IMAGE_DIGEST
CINEGRAPH_RELEASE_SHA=REPLACE_WITH_40_CHAR_GIT_SHA
CINEGRAPH_PUBLISHED_PORT=18001

OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
POSTGRES_USER=cinegraph_prod
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=cinegraph_prod

CINEGRAPH_KNOWLEDGE_ROOT=/app/knowledge
CINEGRAPH_IDENTITY_DATABASE_PATH=/app/knowledge/cinegraph-production.sqlite3
CINEGRAPH_DATABASE_URL=postgresql+psycopg://cinegraph_prod:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/cinegraph_prod
CINEGRAPH_DATABASE_POOL_SIZE=10
CINEGRAPH_DATABASE_MAX_OVERFLOW=10
CINEGRAPH_DATABASE_POOL_TIMEOUT_SECONDS=30
CINEGRAPH_DATABASE_POOL_RECYCLE_SECONDS=1800
CINEGRAPH_QDRANT_MODE=remote
CINEGRAPH_QDRANT_URL=http://qdrant:6333
CINEGRAPH_QDRANT_API_KEY=
CINEGRAPH_QDRANT_COLLECTION_NAME=transcript_segments_production
CINEGRAPH_API_HOST=0.0.0.0
CINEGRAPH_API_PORT=8000
CINEGRAPH_APP_MEMORY_LIMIT=1g
CINEGRAPH_APP_CPU_LIMIT=1.5
CINEGRAPH_POSTGRES_MEMORY_LIMIT=1g
CINEGRAPH_POSTGRES_CPU_LIMIT=1.5
CINEGRAPH_QDRANT_MEMORY_LIMIT=1g
CINEGRAPH_QDRANT_CPU_LIMIT=1.5
